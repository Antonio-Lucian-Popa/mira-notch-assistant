{
  "$schema": "./tokens.schema.json",
  "version": 1,
  "description": "Single source of truth for Mira's notch look & feel. Both the Windows UI (via mira-core::tokens) and the GNOME extension (which reads this JSON directly) consume it, so the notch looks identical on both OSes.",

  "notch": {
    "closed": {
      "width": 180,
      "height": 32,
      "radiusTop": 0,
      "radiusBottom": 16
    },
    "hover": {
      "width": 600,
      "height": 196,
      "radiusTop": 0,
      "radiusBottom": 34
    },
    "alert": {
      "width": 360,
      "height": 60,
      "radiusBottom": 24
    },
    "greeting": {
      "width": 440,
      "height": 72,
      "radiusBottom": 28
    },
    "minimal": {
      "width": 120,
      "height": 6,
      "radiusBottom": 4
    },
    "edgeGap": 0,
    "contentPadding": 14,
    "hoverCloseDelayMs": 300
  },

  "colors": {
    "background": "#0A0A0Bf2",
    "backgroundAlert": "#111113f7",
    "text": "#F2F2F3",
    "textDim": "#9A9AA0",
    "accent": "#5B8CFF",
    "visualizerBar": "#8FB0FF",
    "lyricActive": "#FFFFFF",
    "lyricInactive": "#6E6E76",
    "dotActive": "#F2F2F3",
    "dotInactive": "#44444B",
    "batteryOk": "#58C06B",
    "batteryLow": "#E5534B",
    "charging": "#58C06B",
    "separator": "#26262B",
    "ring": "#2EE6A6",
    "focus": "#FF5A5A",
    "water": "#3B9CFF",
    "waterDim": "#1C4E86",
    "todoDone": "#2EE67A",
    "todoDoneBg": "#13311F",
    "pill": "#1C1C22",
    "pillHover": "#26262E"
  },

  "typography": {
    "clock": { "size": 15, "weight": 600 },
    "title": { "size": 14, "weight": 600 },
    "artist": { "size": 12, "weight": 400 },
    "lyric": { "size": 16, "weight": 600 },
    "alert": { "size": 13, "weight": 500 }
  },

  "motion": {
    "open": { "type": "spring", "stiffness": 420, "damping": 30, "mass": 1.0, "durationMs": 420 },
    "close": { "type": "ease", "easing": "cubic-bezier(0.4, 0.0, 0.2, 1)", "durationMs": 260 },
    "alertIn": { "type": "spring", "stiffness": 500, "damping": 34, "mass": 1.0, "durationMs": 320 },
    "alertOut": { "type": "ease", "easing": "cubic-bezier(0.4, 0.0, 1.0, 1)", "durationMs": 220 },
    "pageSwap": { "type": "ease", "easing": "cubic-bezier(0.33, 1.0, 0.68, 1)", "durationMs": 240 },
    "lyricLine": { "type": "ease", "easing": "cubic-bezier(0.33, 1.0, 0.68, 1)", "durationMs": 280 },
    "alertHoldMs": 2600
  },

  "pages": ["music", "lyrics", "focus", "water", "shelf", "todo"],

  "sizing": {
    "wideMonitorMinWidthPx": 2560,
    "wideScaleFactor": 1.25,
    "minScale": 0.8,
    "maxScale": 1.6
  },

  "visualizer": {
    "bars": 5,
    "minHeight": 3,
    "maxHeight": 14,
    "gap": 2,
    "fps": 30
  },

  "mascot": {
    "idleTimeoutMs": 60000,
    "sleepTransitionMs": 1200
  }
}
